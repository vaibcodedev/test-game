{
  "name": "emberfall-online",
  "version": "0.1.0",
  "private": true,
  "description": "Браузерная 2D MMORPG: Phaser 3 + Colyseus + SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "assets": "tsx tools/gen-assets.ts",
    "predev": "npm run assets",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch --clear-screen=false server/src/index.ts\" \"vite\"",
    "build": "npm run assets && vite build",
    "start": "npm run build && tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/keybinds.ts && tsx tests/cast-resolve.ts && tsx tests/controls.ts && tsx tests/hotbar.ts && tsx tests/gearFx.ts && tsx tests/auras.ts && tsx tests/cities.ts && tsx tests/accounts.ts && tsx tests/bots.ts && tsx tests/los.ts && tsx tests/move.ts && tsx tests/factions.ts && tsx tests/cities-net.ts && tsx tests/arena.ts && tsx tests/trade.ts && tsx tests/admin.ts && tsx tests/reconnect.ts && tsx tests/raid.ts && tsx tests/skill-fx.ts",
    "test:trade": "tsx tests/trade.ts && tsx tests/admin.ts",
    "test:cities": "tsx tests/cities.ts && tsx tests/cities-net.ts",
    "test:arena": "tsx tests/arena.ts",
    "test:raid": "tsx tests/raid.ts",
    "screenshot:raid": "tsx tests/raid-screens.ts",
    "test:reconnect": "tsx tests/reconnect.ts",
    "screenshot:reconnect": "tsx tests/reconnect-screens.ts",
    "screenshot": "tsx tests/screenshot.ts",
    "screenshot:arena": "tsx tests/arena-screens.ts",
    "screenshot:admin": "tsx tests/admin-screens.ts",
    "screenshot:keys": "tsx tests/keybinds-screens.ts",
    "screenshot:hotbar": "tsx tests/hotbar-screens.ts",
    "test:admin": "tsx tests/admin.ts",
    "db": "tsx tools/db.ts",
    "desktop:icon": "tsx tools/gen-icon.ts",
    "desktop:bundle": "tsx desktop/scripts/bundle.ts",
    "desktop:typecheck": "tsc --noEmit -p desktop/tsconfig.json",
    "desktop:dev": "npm run build && npm run desktop:bundle && tsx desktop/scripts/run.ts",
    "desktop:smoke": "npm run build && npm run desktop:bundle && tsx desktop/scripts/run.ts --smoke",
    "desktop:build": "npm run build && npm run desktop:bundle && electron-builder --win --config desktop/electron-builder.yml"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@fontsource/rubik": "^5.3.0",
    "colyseus.js": "^0.16.22",
    "express": "^4.22.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
